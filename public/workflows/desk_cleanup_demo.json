{
  "schema": "groundzero.bpmn-action-tree/1",
  "process": {
    "id": "desk_cleanup_demo",
    "name": "Clean up the workstation",
    "version": "0.1"
  },

  "state_model": {
    "task_states": ["pending", "ready", "active", "completed", "failed", "blocked", "skipped"]
  },

  "nodes": [
    {
      "id": "start",
      "bpmn_type": "startEvent",
      "name": "Start desk cleanup",
      "state": "completed"
    },

    {
      "id": "n1",
      "bpmn_type": "userTask",
      "name": "Check the bottle",
      "description": "Pick up the transparent bottle with the red label on the left side of the desk and check whether it is empty.",
      "state": "ready",
      "lineage": {
        "parents": ["start"],
        "rationale": "The bottle is the first clearly identifiable object in the cleanup sequence."
      },
      "slots": {
        "object": "transparent bottle with red label",
        "location": "left side of desk",
        "tool": "hand",
        "intent": "determine whether the bottle is trash",
        "precondition": "bottle is standing on the desk",
        "effect": "bottle state is classified as empty or non-empty"
      },
      "ar": {
        "anchor": { "type": "object", "label": "red-label bottle" },
        "instruction": "Pick up the bottle",
        "success_condition": "bottle has been lifted from its original position"
      }
    },

    {
      "id": "g1",
      "bpmn_type": "exclusiveGateway",
      "name": "Is the bottle empty?",
      "gateway": { "type": "XOR", "decision_variable": "bottle_empty" }
    },

    {
      "id": "n2a",
      "bpmn_type": "userTask",
      "name": "Remove bottle as trash",
      "description": "If the bottle is empty, remove it from the desk and place it in the recycling or trash area.",
      "state": "pending",
      "lineage": {
        "parents": ["g1"],
        "rationale": "Empty bottle is treated as desk clutter.",
        "split_from": "g1"
      },
      "slots": {
        "object": "empty bottle",
        "intent": "remove trash from workspace",
        "precondition": "bottle_empty == true",
        "effect": "bottle is no longer on the desk"
      },
      "ar": {
        "anchor": { "type": "object", "label": "red-label bottle" },
        "instruction": "Remove the empty bottle",
        "success_condition": "bottle disappears from the desk area"
      }
    },

    {
      "id": "n2b",
      "bpmn_type": "userTask",
      "name": "Move bottle away from workspace",
      "description": "If the bottle is not empty, close it and move it away from the active working area.",
      "state": "pending",
      "lineage": {
        "parents": ["g1"],
        "rationale": "A non-empty bottle should be preserved but moved away from electronics.",
        "split_from": "g1"
      },
      "slots": {
        "object": "non-empty bottle",
        "intent": "clear active workspace",
        "precondition": "bottle_empty == false",
        "effect": "bottle is outside the central working area"
      },
      "ar": {
        "anchor": { "type": "object", "label": "red-label bottle" },
        "instruction": "Move the bottle away from the laptop",
        "success_condition": "bottle is outside the desk work zone"
      }
    },

    {
      "id": "g2",
      "bpmn_type": "exclusiveGateway",
      "name": "Bottle branch merged",
      "gateway": { "type": "XOR_MERGE" }
    },

    {
      "id": "n3",
      "bpmn_type": "userTask",
      "name": "Turn the notebook page",
      "description": "Turn one page of the open notebook located to the right of the laptop.",
      "state": "pending",
      "lineage": {
        "parents": ["g2"],
        "rationale": "Simple manipulation task suitable for testing fine-grained AR guidance."
      },
      "slots": {
        "object": "open notebook",
        "location": "right side of laptop",
        "tool": "hand",
        "intent": "turn to the next page",
        "precondition": "notebook is open",
        "effect": "next notebook page is visible"
      },
      "ar": {
        "anchor": { "type": "object", "label": "open notebook" },
        "instruction": "Turn one page",
        "success_condition": "visible notebook page has changed"
      }
    },

    {
      "id": "n4",
      "bpmn_type": "userTask",
      "name": "Place the pen on the notebook",
      "description": "Take the black pen next to the notebook and place it horizontally on top of the notebook.",
      "state": "pending",
      "lineage": {
        "parents": ["n3"],
        "rationale": "Creates a simple object-to-object spatial placement task."
      },
      "slots": {
        "object": "black pen",
        "target": "notebook",
        "tool": "hand",
        "intent": "organize desk",
        "precondition": "notebook page has been turned",
        "effect": "pen rests on top of notebook"
      },
      "ar": {
        "anchor": { "type": "object", "label": "black pen" },
        "target_anchor": { "type": "object", "label": "open notebook" },
        "instruction": "Put the pen on the notebook",
        "success_condition": "pen overlaps the notebook area"
      }
    },

    {
      "id": "n5",
      "bpmn_type": "userTask",
      "name": "Inspect loose cables",
      "description": "Check the area between the laptop and the black case for loose cables, adapters or small electronic accessories.",
      "state": "pending",
      "lineage": {
        "parents": ["n4"],
        "rationale": "The central-right desk area contains several loose electronic objects."
      },
      "slots": {
        "object": "loose cables and adapters",
        "location": "between laptop and black case",
        "intent": "detect remaining clutter",
        "precondition": "previous desk objects have been organized",
        "effect": "loose_items_present is determined"
      },
      "ar": {
        "anchor": { "type": "region", "label": "cable area" },
        "instruction": "Check for loose cables or adapters"
      }
    },

    {
      "id": "g3",
      "bpmn_type": "exclusiveGateway",
      "name": "Are loose items present?",
      "gateway": { "type": "XOR", "decision_variable": "loose_items_present" }
    },

    {
      "id": "n6",
      "bpmn_type": "userTask",
      "name": "Put loose items into the case",
      "description": "Collect the loose cables and adapters and place them into the black case on the right side of the desk.",
      "state": "pending",
      "lineage": {
        "parents": ["g3"],
        "rationale": "Loose electronics should be stored if detected.",
        "split_from": "g3"
      },
      "slots": {
        "object": "loose cables and adapters",
        "target": "black case",
        "intent": "clear desk clutter",
        "precondition": "loose_items_present == true",
        "effect": "loose electronic objects are stored"
      },
      "ar": {
        "anchor": { "type": "region", "label": "loose electronics" },
        "target_anchor": { "type": "object", "label": "black case" },
        "instruction": "Put the loose items into the black case",
        "success_condition": "loose items disappear from the desk surface"
      }
    },

    {
      "id": "n7",
      "bpmn_type": "userTask",
      "name": "Verify workspace",
      "description": "Check that the central area in front of the laptop is clear of trash and loose objects.",
      "state": "pending",
      "lineage": {
        "parents": ["g3", "n6"],
        "rationale": "Final verification is performed regardless of whether loose items were found."
      },
      "slots": {
        "object": "desk workspace",
        "intent": "verify cleanup result",
        "precondition": "cleanup actions finished",
        "effect": "workspace is confirmed clear"
      },
      "ar": {
        "anchor": { "type": "region", "label": "central desk workspace" },
        "instruction": "Check that the workspace is clear",
        "success_condition": "workspace_clear == true"
      }
    },

    {
      "id": "end",
      "bpmn_type": "endEvent",
      "name": "Desk cleanup completed",
      "state": "pending"
    }
  ],

  "flows": [
    { "id": "f1", "source": "start", "target": "n1" },
    { "id": "f2", "source": "n1", "target": "g1" },
    { "id": "f3", "source": "g1", "target": "n2a", "condition": { "expression": "bottle_empty == true" } },
    { "id": "f4", "source": "g1", "target": "n2b", "condition": { "expression": "bottle_empty == false" } },
    { "id": "f5", "source": "n2a", "target": "g2" },
    { "id": "f6", "source": "n2b", "target": "g2" },
    { "id": "f7", "source": "g2", "target": "n3" },
    { "id": "f8", "source": "n3", "target": "n4" },
    { "id": "f9", "source": "n4", "target": "n5" },
    { "id": "f10", "source": "n5", "target": "g3" },
    { "id": "f11", "source": "g3", "target": "n6", "condition": { "expression": "loose_items_present == true" } },
    { "id": "f12", "source": "g3", "target": "n7", "condition": { "expression": "loose_items_present == false" } },
    { "id": "f13", "source": "n6", "target": "n7" },
    { "id": "f14", "source": "n7", "target": "end" }
  ],

  "runtime": {
    "current_node": "n1",
    "variables": {
      "bottle_empty": null,
      "loose_items_present": null,
      "workspace_clear": null
    }
  }
}
